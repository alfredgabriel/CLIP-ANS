<Window x:Class="QuizHelper.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIP-ANS Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20"
        Opacity="0">

    <Grid x:Name="RootContainer"
          Margin="6"
          MouseLeftButtonDown="RootContainer_MouseLeftButtonDown"
          Cursor="SizeAll"
          ToolTip="CLIP-ANS Overlay (Arrastra para mover • Ctrl+Shift+Space para alternar)">

        <!-- Multiple-choice letters panel (compact circle badges) -->
        <StackPanel x:Name="LettersPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Visible"/>

        <!-- Direct / open-ended text badge (compact rounded pill) -->
        <Border x:Name="TextPanel"
                Background="#EE141414"
                BorderBrush="#00E6FF"
                BorderThickness="1.5"
                CornerRadius="19"
                Height="38"
                Padding="12,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="DirectAnswerText"
                       FontFamily="Consolas, Segoe UI, Courier New"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Waiting / Querying / Idle badge (small circle) -->
        <Border x:Name="WaitingBadge"
                Width="38" Height="38"
                CornerRadius="19"
                Background="#EE141414"
                BorderBrush="#55FFFFFF"
                BorderThickness="1.5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="WaitingText"
                       Text="···"
                       FontFamily="Consolas, Segoe UI, Courier New"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#CCCCCC"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
