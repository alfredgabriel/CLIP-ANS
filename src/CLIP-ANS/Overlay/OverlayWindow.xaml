<Window x:Class="QuizHelper.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIP-ANS Overlay"
        Width="220" Height="90"
        MinWidth="120" MinHeight="50"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20"
        Opacity="0">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="LetterBadge" TargetType="Border">
                <Setter Property="Width"           Value="46"/>
                <Setter Property="Height"          Value="46"/>
                <Setter Property="CornerRadius"    Value="23"/>
                <Setter Property="BorderBrush"     Value="#FFFFFF"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin"          Value="3,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer drag handle -->
    <Border x:Name="RootBorder"
            Background="#CC000000"
            CornerRadius="14"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            Cursor="SizeAll">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Answer display area -->
            <Grid Grid.Row="0" Margin="12,10,12,4">

                <!-- Multiple-choice letters panel -->
                <WrapPanel x:Name="LettersPanel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- Direct / open-ended text panel -->
                <ScrollViewer x:Name="TextScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              MaxHeight="64">
                    <TextBlock x:Name="DirectAnswerText"
                               FontFamily="Consolas, Courier New"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </ScrollViewer>

                <!-- Waiting state -->
                <TextBlock x:Name="WaitingText"
                           Text="..."
                           FontFamily="Consolas, Courier New"
                           FontSize="16"
                           Foreground="#555555"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Drag hint bar at bottom -->
            <Border Grid.Row="1"
                    Height="6"
                    Margin="40,0,40,6"
                    Background="#33FFFFFF"
                    CornerRadius="3"/>
        </Grid>
    </Border>
</Window>
