<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════
         QUIZ HELPER — BRUTALIST STYLE DICTIONARY
         Palette: #000000 background, #FFFFFF text/borders
         No gradients. No shadows. No rounded corners.
         Inversion on hover/active.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Fonts: JetBrains Mono when embedded, Consolas as system fallback -->
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
    <!-- After running setup.ps1, change the line above to:
         pack://application:,,,/Resources/Fonts/#JetBrains Mono,Consolas,Courier New -->

    <!-- Colors -->
    <SolidColorBrush x:Key="BgBrush"       Color="#000000"/>
    <SolidColorBrush x:Key="FgBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DimBrush"      Color="#444444"/>
    <SolidColorBrush x:Key="ErrorBrush"    Color="#FFFFFF"/>

    <!-- ── Window ────────────────────────────────────────────────────── -->
    <Style x:Key="BrutalistWindow" TargetType="Window">
        <Setter Property="Background"        Value="{StaticResource BgBrush}"/>
        <Setter Property="Foreground"        Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily"        Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"          Value="13"/>
        <Setter Property="ResizeMode"        Value="CanResize"/>
        <Setter Property="BorderThickness"   Value="0"/>
    </Style>

    <!-- ── Section label (UPPERCASE, small) ─────────────────────────── -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground"     Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily"     Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"       Value="10"/>
        <Setter Property="FontWeight"     Value="Bold"/>
        <Setter Property="Margin"         Value="0,0,0,6"/>
    </Style>

    <!-- ── Value text ────────────────────────────────────────────────── -->
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily"  Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Status display (large) ───────────────────────────────────── -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily"  Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"    Value="16"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Section block border ──────────────────────────────────────── -->
    <Style x:Key="SectionBlock" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding"         Value="14,10"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="Background"      Value="{StaticResource BgBrush}"/>
    </Style>

    <!-- ── Button (white border, black bg; hover = white bg, black text) -->
    <Style x:Key="BrutalistButton" TargetType="Button">
        <Setter Property="Background"        Value="#000000"/>
        <Setter Property="Foreground"        Value="#FFFFFF"/>
        <Setter Property="BorderBrush"       Value="#FFFFFF"/>
        <Setter Property="BorderThickness"   Value="2"/>
        <Setter Property="FontFamily"        Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Padding"           Value="16,8"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#444444"/>
                            <Setter Property="Foreground" Value="#444444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Danger button (for destructive actions) ───────────────────── -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BrutalistButton}">
        <Setter Property="BorderBrush" Value="#FF4444"/>
        <Setter Property="Foreground"  Value="#FF4444"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="#FF4444"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TextBox ───────────────────────────────────────────────────── -->
    <Style x:Key="BrutalistTextBox" TargetType="TextBox">
        <Setter Property="Background"       Value="#000000"/>
        <Setter Property="Foreground"       Value="#FFFFFF"/>
        <Setter Property="BorderBrush"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness"  Value="2"/>
        <Setter Property="FontFamily"       Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="CaretBrush"       Value="#FFFFFF"/>
        <Setter Property="SelectionBrush"   Value="#FFFFFF"/>
        <Setter Property="SelectionTextBrush" Value="#000000"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ── PasswordBox ───────────────────────────────────────────────── -->
    <Style x:Key="BrutalistPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background"       Value="#000000"/>
        <Setter Property="Foreground"       Value="#FFFFFF"/>
        <Setter Property="BorderBrush"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness"  Value="2"/>
        <Setter Property="FontFamily"       Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="CaretBrush"       Value="#FFFFFF"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ── ComboBox ─────────────────────────────────────────────────── -->
    <Style x:Key="BrutalistComboBox" TargetType="ComboBox">
        <Setter Property="Background"       Value="#EEEEEE"/>
        <Setter Property="Foreground"       Value="#000000"/>
        <Setter Property="BorderBrush"      Value="#555555"/>
        <Setter Property="BorderThickness"  Value="1.5"/>
        <Setter Property="FontFamily"       Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"   Value="#FFFFFF"/>
                    <Setter Property="Foreground"   Value="#000000"/>
                    <Setter Property="FontFamily"   Value="{StaticResource MonoFont}"/>
                    <Setter Property="Padding"      Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#000000"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle / CheckBox ────────────────────────────────────────── -->
    <Style x:Key="BrutalistCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground"   Value="#FFFFFF"/>
        <Setter Property="FontFamily"   Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Cursor"       Value="Hand"/>
    </Style>

    <!-- ── Slider ────────────────────────────────────────────────────── -->
    <Style x:Key="BrutalistSlider" TargetType="Slider">
        <Setter Property="Foreground"  Value="#FFFFFF"/>
        <Setter Property="Background"  Value="#444444"/>
    </Style>

    <!-- ── Separator ─────────────────────────────────────────────────── -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,8"/>
    </Style>

    <!-- ── ScrollBar minimal brutalist ────────────────────────────── -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="#141414">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="3" Margin="0,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="#141414">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="3" Margin="1,0"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="true">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
