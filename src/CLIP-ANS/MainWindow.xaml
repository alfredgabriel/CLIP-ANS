<Window x:Class="QuizHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuizHelper"
        Title="CLIP-ANS"
        Width="920" MinWidth="780"
        Height="640" MinHeight="520"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource MonoFont}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource BrutalistWindow}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Main 0-scrollbar responsive dashboard container -->
    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════ HEADER ══════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CLIP"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="-ANS"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource MonoFont}"/>
                <Border Width="8" Height="8" Background="#00E6FF"
                        Margin="8,4,0,0" VerticalAlignment="Top"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="AI QUIZ COPILOT — v1.1"
                       FontSize="11"
                       Foreground="#777777"
                       FontFamily="{StaticResource MonoFont}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ══════ 2-COLUMN DASHBOARD (RESPONSIVE, NO SCROLLBAR) ══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN: CONFIGURACIÓN IA & DETECCIÓN ── -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════ BLOQUE PROVEEDOR IA ══════ -->
                <Border Grid.Row="0" Style="{StaticResource SectionBlock}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PROVEEDOR IA" Style="{StaticResource SectionLabel}"/>

                        <!-- Provider & Model side-by-side -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Provider -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="PROVEEDOR" Style="{StaticResource SectionLabel}" Margin="0,2,0,3"/>
                                <ComboBox x:Name="ProviderCombo"
                                          Style="{StaticResource BrutalistComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ProviderCombo_SelectionChanged">
                                    <ComboBoxItem Content="GROQ"   Tag="groq" Foreground="#000000"/>
                                    <ComboBoxItem Content="OPENAI" Tag="openai" Foreground="#000000"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Model -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MODELO" Style="{StaticResource SectionLabel}" Margin="0,2,0,3"/>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelCombo"
                                              Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource BrutalistComboBox}"/>
                                    <Button Grid.Column="1"
                                            x:Name="RefreshModelsBtn"
                                            Content="↺"
                                            Style="{StaticResource BrutalistButton}"
                                            Padding="10,5"
                                            Margin="5,0,0,0"
                                            ToolTip="Cargar modelos disponibles"
                                            Click="RefreshModelsBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- API Key -->
                        <TextBlock Text="API KEY" Style="{StaticResource SectionLabel}" Margin="0,8,0,3"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox"
                                         Grid.Column="0"
                                         HorizontalAlignment="Stretch"
                                         Style="{StaticResource BrutalistPasswordBox}"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
                            <Button Grid.Column="1"
                                    x:Name="ShowKeyBtn"
                                    Content="◉"
                                    Style="{StaticResource BrutalistButton}"
                                    Padding="10,5"
                                    Margin="5,0,0,0"
                                    ToolTip="Mostrar / Ocultar API key"
                                    Click="ShowKeyBtn_Click"/>
                        </Grid>
                        <!-- Plain text fallback for "show key" mode -->
                        <TextBox x:Name="ApiKeyPlain"
                                 Style="{StaticResource BrutalistTextBox}"
                                 HorizontalAlignment="Stretch"
                                 Visibility="Collapsed"
                                 Margin="0,4,0,0"
                                 TextChanged="ApiKeyPlain_TextChanged"/>

                        <!-- Test connection -->
                        <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="PROBAR CONEXIÓN"
                                    Style="{StaticResource BrutalistButton}"
                                    Padding="12,6"
                                    Click="TestConnectionBtn_Click"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="TestResultLabel"
                                       Style="{StaticResource ValueText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Text=""/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════ BLOQUE COMPORTAMIENTO ══════ -->
                <Border Grid.Row="1" Style="{StaticResource SectionBlock}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="COMPORTAMIENTO" Style="{StaticResource SectionLabel}"/>

                        <!-- Detection toggle -->
                        <CheckBox x:Name="DetectionToggle"
                                  Style="{StaticResource BrutalistCheckBox}"
                                  Content="DETECCIÓN ACTIVA"
                                  IsChecked="True"
                                  Margin="0,2,0,4"
                                  Checked="DetectionToggle_Changed"
                                  Unchecked="DetectionToggle_Changed"/>

                        <!-- Screenshot / OCR toggle -->
                        <CheckBox x:Name="ScreenshotToggle"
                                  Style="{StaticResource BrutalistCheckBox}"
                                  Content="DETECTAR CAPTURAS DE PANTALLA (OCR)"
                                  IsChecked="True"
                                  Margin="0,0,0,8"
                                  Checked="ScreenshotToggle_Changed"
                                  Unchecked="ScreenshotToggle_Changed"/>

                        <!-- Min text length -->
                        <TextBlock Text="LONGITUD MÍNIMA DE TEXTO" Style="{StaticResource SectionLabel}" Margin="0,2,0,1"/>
                        <Grid Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MinLengthSlider"
                                    Grid.Column="0"
                                    Minimum="10" Maximum="500"
                                    Value="20"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="MinLengthSlider_Changed"
                                    HorizontalAlignment="Stretch"
                                    Foreground="#FFFFFF"
                                    Background="#333333"/>
                            <TextBlock x:Name="MinLengthLabel"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueText}"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="20 chars"/>
                        </Grid>

                        <!-- Debounce -->
                        <TextBlock Text="DEBOUNCE (MS)" Style="{StaticResource SectionLabel}" Margin="0,2,0,1"/>
                        <Grid Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DebounceSlider"
                                    Grid.Column="0"
                                    Minimum="100" Maximum="2000"
                                    Value="400"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="DebounceSlider_Changed"
                                    HorizontalAlignment="Stretch"
                                    Foreground="#FFFFFF"
                                    Background="#333333"/>
                            <TextBlock x:Name="DebounceLabel"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueText}"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="400 ms"/>
                        </Grid>

                        <!-- Save button -->
                        <Button Content="GUARDAR CONFIGURACIÓN"
                                Style="{StaticResource BrutalistButton}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                Click="SaveConfigBtn_Click"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── RIGHT COLUMN: ESTADO, COLORES & HISTORIAL ── -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══════ BLOQUE ESTADO ══════ -->
                <Border Grid.Row="0" Style="{StaticResource SectionBlock}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ESTADO EN TIEMPO REAL" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Circular status chip reflecting tray icon color(s) -->
                            <Border x:Name="StatusChip"
                                    Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1.5"
                                    Background="#FFFFFF"
                                    Margin="0,2,10,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock"
                                       Grid.Column="1"
                                       Style="{StaticResource StatusText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Text="{Binding StatusText, Mode=OneWay}"
                                       DataContext="{x:Static local:AppStateProxy.Instance}"/>
                        </Grid>
                        <TextBlock x:Name="LastAnswerLabel"
                                   Style="{StaticResource ValueText}"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#CCCCCC"
                                   Text="{Binding LastAnswerDisplay, StringFormat='Última respuesta: \{0\}',
                                                  Mode=OneWay,
                                                  FallbackValue='Última respuesta: —'}"
                                   DataContext="{x:Static local:AppStateProxy.Instance}"/>
                    </StackPanel>
                </Border>

                <!-- ══════ BLOQUE LEYENDA DE COLORES ══════ -->
                <Border Grid.Row="1" Style="{StaticResource SectionBlock}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COLORES DE OPCIONES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Grid.Column="1" Text="Click para cambiar"
                                       Style="{StaticResource ValueText}"
                                       FontSize="10" Foreground="#777777"/>
                        </Grid>

                        <!-- Legend rows (compact, responsive) -->
                        <ItemsControl x:Name="LegendItems" HorizontalAlignment="Stretch" Margin="0,2,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Letter label -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Letter}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="#FFFFFF"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Center"/>
                                        <!-- Color chip (clickable, fills width) -->
                                        <Button Grid.Column="1"
                                                Background="{Binding ColorBrush}"
                                                BorderBrush="#444444"
                                                BorderThickness="1"
                                                Height="22"
                                                HorizontalAlignment="Stretch"
                                                Cursor="Hand"
                                                Click="ColorChip_Click"
                                                Tag="{Binding Letter}"
                                                ToolTip="Cambiar color"/>
                                        <!-- Hex label -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding HexColor}"
                                                   Style="{StaticResource ValueText}"
                                                   FontSize="9"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="4,0,0,0"/>
                                        <!-- Delete button -->
                                        <Button Grid.Column="3"
                                                Content="×"
                                                Width="20" Height="20"
                                                Margin="2,0,0,0"
                                                Padding="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#FF4444"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="DeleteOptionBtn_Click"
                                                Tag="{Binding Letter}"
                                                ToolTip="Eliminar opción"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="+ AÑADIR OPCIÓN"
                                    Style="{StaticResource BrutalistButton}"
                                    Padding="10,5"
                                    FontSize="10"
                                    Margin="0,0,6,0"
                                    Click="AddOptionBtn_Click"
                                    ToolTip="Añade la siguiente letra disponible (F, G, H...)"/>
                            <Button Content="RESTAURAR"
                                    Style="{StaticResource BrutalistButton}"
                                    Padding="10,5"
                                    FontSize="10"
                                    Click="ResetColorsBtn_Click"
                                    ToolTip="Restaurar colores por defecto (A-F)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══════ BLOQUE HISTORIAL ══════ -->
                <Border Grid.Row="2" Style="{StaticResource SectionBlock}" Margin="0,0,0,0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header toggle -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HistoryToggleBtn"
                                    Grid.Column="0"
                                    Content="− HISTORIAL"
                                    Style="{StaticResource BrutalistButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    BorderThickness="0"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Click="HistoryToggleBtn_Click"/>
                            <TextBlock Grid.Column="1"
                                       Text="(máx. 10)"
                                       Style="{StaticResource ValueText}"
                                       FontSize="10" Foreground="#555555"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="HistoryPanel" Grid.Row="1" Margin="0,6,0,0">
                            <ListView x:Name="HistoryList"
                                      Background="#000000"
                                      BorderThickness="1"
                                      BorderBrush="#222222"
                                      Foreground="#FFFFFF"
                                      FontFamily="{StaticResource MonoFont}"
                                      FontSize="10"
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="HORA"   Width="65"/>
                                        <GridViewColumn Header="RESP."  Width="55"/>
                                        <GridViewColumn Header="PREGUNTA" Width="260"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══════ FOOTER ══════ -->
        <TextBlock Grid.Row="2"
                   Text="CLIP-ANS v1.1 — COPIA PREGUNTA CON CTRL+C PARA ACTIVAR | MINIMIZA AL TRAY"
                   Style="{StaticResource ValueText}"
                   FontSize="10"
                   Foreground="#444444"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

    </Grid>
</Window>
