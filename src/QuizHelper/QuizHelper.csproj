<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QuizHelper</RootNamespace>
    <AssemblyName>CLIP-ANS</AssemblyName>
    <Product>CLIP-ANS</Product>
    <Title>CLIP-ANS</Title>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Set app icon only when the file exists (added by setup.ps1 or commit 5) -->
    <ApplicationIcon Condition="Exists('Resources\app_icon.ico')">Resources\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts: included only when present (run setup.ps1 first) -->
    <Resource Include="Resources\Fonts\JetBrainsMono-Regular.ttf"
              Condition="Exists('Resources\Fonts\JetBrainsMono-Regular.ttf')" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Bold.ttf"
              Condition="Exists('Resources\Fonts\JetBrainsMono-Bold.ttf')" />
    <!-- App icon resource (added in commit 5) -->
    <Resource Include="Resources\app_icon.ico"
              Condition="Exists('Resources\app_icon.ico')" />
  </ItemGroup>

</Project>
